# ==============================================================================
# TradePulse Environment Configuration
# Copy this file to .env.local for local development or set in Vercel Project Settings.
# ==============================================================================

# Supabase Configuration (Required for Cloud Database & User Authentication)
# Obtain these from your Supabase Project Settings -> API (URL and anon public key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Optional Gemini API Key for AI Coaching & Journal Audits
GEMINI_API_KEY=""

# Host Application URL
APP_URL="https://your-tradepulse-domain.vercel.app"
